{
  "name": "shopify-profit-doctor",
  "version": "0.1.0",
  "description": "Intelligent profit analysis tool for Shopify merchants",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development nodemon --exec node --loader tsx src/server.ts",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "@shopify/shopify-app-express": "^2.0.0",
    "@shopify/shopify-api": "^11.0.0",
    "postgresql": "^1.0.0",
    "pg": "^8.10.0",
    "kysely": "^0.26.3",
    "redis": "^4.6.5",
    "bull": "^4.11.1",
    "jsonwebtoken": "^9.0.0",
    "express-jwt": "^8.4.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "dotenv": "^16.3.1",
    "pino": "^8.14.1",
    "pino-pretty": "^10.2.0",
    "uuid": "^9.0.0",
    "axios": "^1.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/jest": "^29.5.0",
    "typescript": "^5.0.0",
    "tsx": "^3.14.0",
    "nodemon": "^3.0.1",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.40.0"
  }
}
