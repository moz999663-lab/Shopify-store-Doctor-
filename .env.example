# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/profit_doctor_dev

# Shopify
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_APP_ID=your_app_id_here
SHOPIFY_SCOPES=write_products,read_products,write_orders,read_orders,write_discounts,read_discounts,write_inventory,read_inventory,write_customers,read_customers

# Redis (for background jobs)
REDIS_URL=redis://localhost:6379

# JWT Secret
JWT_SECRET=your_jwt_secret_here_change_in_production

# Logging
LOG_LEVEL=info

# Frontend
REACT_APP_API_URL=http://localhost:3000/api
